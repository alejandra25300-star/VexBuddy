  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b771e3cea49dd24a92ea017231f4493, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelNota: {fileID: 2119124407}
  textoNota: {fileID: 689049760}
  mensaje: "\u2014 Nota de mam\xE1 \u2014\n\nHijo:\n\nSi est\xE1s leyendo esto, significa
    que ya no estoy contigo.\n\nPerd\xF3name por no haber sido la madre que necesitabas.
    Comet\xED muchos errores, pero quiero que sepas que siempre te quise.\n\nT\xFA
    fuiste la luz de mis d\xEDas.\nEspero que alg\xFAn d\xEDa puedas perdonarme y
    seguir adelante.\n\nS\xE9 fuerte, hijo. M\xE1s de lo que yo pude ser.\n\nTe amo.\n\n\u2014
    Mam\xE1 \u2014 "
